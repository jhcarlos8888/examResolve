{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3.5-super-vl-free",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bash",
          "./scripts/playwright-mcp-brave.sh"
        ],
        "cwd": ".",
        "environment": {
          "DISPLAY": ":0",
          "PW_MCP_CONFIG": "scripts/playwright-mcp.config.json"
        },
        "timeout": {
          "startup": 60000,
          "execution": 60000
        }
      }
    }
  },
  "permission": {
    "question": "allow",
    "bash": {
      "*": "ask",
      "./scripts/*": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "node scripts/recon.mjs*": "allow"
    },
    "external_directory": "ask"
  }
}
