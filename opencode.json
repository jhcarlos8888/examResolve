{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "exam-operator",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "disabled": false,
        "command": [
          "bash",
          "./scripts/playwright-mcp-brave.sh"
        ],
        "cwd": ".",
        "environment": {
          "PW_MCP_CONFIG": "scripts/playwright-mcp.config.json"
        },
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "./scripts/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "node scripts/recon.mjs*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
