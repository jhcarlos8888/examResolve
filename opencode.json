{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.6-flash",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/playwright-mcp-brave.sh"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "question": "allow",
    "bash": {
      "*": "ask",
      "./scripts/*": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "node scripts/recon.mjs*": "allow"
    },
    "external_directory": "ask"
  }
}
